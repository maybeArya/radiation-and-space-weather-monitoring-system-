                <h4>1. REST API Endpoint Specification</h4>
                <p>The Flask backend accepts telemetry via standard HTTP POST:</p>
                <pre class="code-block">POST http://&lt;YOUR_PC_LOCAL_IP&gt;:5000/api/readings
Content-Type: application/json

{
  "radiation": 0.24,
  "temperature": 26.5,
  "voltage": 3.31,
  "current": 0.18,
  "magnetic": 47.8,
  "source": "esp32"
}</pre>

                <h4>2. Ready-to-Flash Arduino / ESP32 C++ Snippet</h4>
                <pre class="code-block">#include &lt;WiFi.h&gt;
#include &lt;HTTPClient.h&gt;
#include &lt;ArduinoJson.h&gt;

const char* ssid = "YOUR_WIFI_SSID";
const char* password = "YOUR_WIFI_PASSWORD";
// Find your PC IP using 'ipconfig' in Windows PowerShell
const char* serverUrl = "http://192.168.1.100:5000/api/readings";

void setup() {
  Serial.begin(115200);
  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println("\nWiFi Connected! Ready to stream telemetry.");
}

void loop() {
  if (WiFi.status() == WL_CONNECTED) {
    HTTPClient http;
    http.begin(serverUrl);
    http.addHeader("Content-Type", "application/json");

    // Read your physical sensors (Geiger tube, thermistor, ADC, magnetometer)
    StaticJsonDocument&lt;200&gt; doc;
    doc["radiation"] = 0.22;    // Replace with Geiger counter reading (uSv/h)
    doc["temperature"] = 25.4;  // Replace with physical temp sensor (deg C)
    doc["voltage"] = 3.30;      // Replace with ADC rail voltage (V)
    doc["current"] = 0.19;      // Replace with current sensor (A)
    doc["magnetic"] = 48.2;     // Replace with I2C magnetometer (uT)
    doc["source"] = "esp32";

    String requestBody;
    serializeJson(doc, requestBody);

    int httpResponseCode = http.POST(requestBody);
    Serial.printf("POST status: %d\n", httpResponseCode);
    http.end();
  }
  delay(2000); // 2 second telemetry cadence
}</pre>

