/* ==========================================================================
   Radiation and Space-Weather Monitor - Aerospace Dashboard Stylesheet
   Dark Navy / Indigo Palette with Cyan, Emerald, Amber, and Red Accents
   ========================================================================== */

:root {
    /* Base Palette */
    --bg-dark: #070b14;
    --bg-surface: #0e1626;
    --bg-surface-elevated: #141f36;
    --bg-card: #111a2e;
    --bg-card-hover: #16223d;
    --border-subtle: #1e293b;
    --border-bright: #334155;
    --border-cyan: rgba(34, 211, 238, 0.3);

    /* Text Colors */
    --text-primary: #f8fafc;
    --text-secondary: #94a3b8;
    --text-muted: #64748b;
    --text-highlight: #e2e8f0;

    /* Aerospace Neon Accents */
    --cyan: #22d3ee;
    --cyan-glow: rgba(34, 211, 238, 0.25);
    --blue: #38bdf8;
    --indigo: #818cf8;
    --purple: #a855f7;
    
    /* Status Colors */
    --status-normal: #10b981;
    --status-normal-bg: rgba(16, 185, 129, 0.15);
    --status-warning: #f59e0b;
    --status-warning-bg: rgba(245, 158, 11, 0.15);
    --status-critical: #ef4444;
    --status-critical-bg: rgba(239, 68, 68, 0.2);

    /* Fonts */
    --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    --font-mono: 'JetBrains Mono', "Cascadia Code", Consolas, monospace;

    /* Layout metrics */
    --sidebar-width: 260px;
    --topbar-height: 70px;
    --radius-sm: 6px;
    --radius-md: 10px;
    --radius-lg: 14px;
    --shadow-card: 0 4px 20px -2px rgba(0, 0, 0, 0.5), 0 0 1px 1px rgba(255, 255, 255, 0.05);
}

/* CSS Reset */
*, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html, body {
    height: 100%;
    width: 100%;
    overflow-x: hidden;
}

body.dark-theme {
    background-color: var(--bg-dark);
    color: var(--text-primary);
    font-family: var(--font-sans);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
}

/* Layout Container */
.app-layout {
    display: flex;
    min-height: 100vh;
    width: 100%;
    position: relative;
}

/* ==========================================================================
   SIDEBAR NAVIGATION
   ========================================================================== */
.sidebar {
    width: var(--sidebar-width);
    background-color: var(--bg-surface);
    border-right: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    position: sticky;
    top: 0;
    height: 100vh;
    z-index: 100;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.sidebar-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 20px;
    border-bottom: 1px solid var(--border-subtle);
}

.brand-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, rgba(34, 211, 238, 0.15), rgba(168, 85, 247, 0.15));
    border: 1px solid var(--border-cyan);
}

.brand-text {
    display: flex;
    flex-direction: column;
}

.brand-title {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--cyan);
    font-family: var(--font-mono);
}

.brand-subtitle {
    font-size: 0.72rem;
    color: var(--text-muted);
}

.drawer-close-btn {
    display: none;
    margin-left: auto;
    background: none;
    border: none;
    color: var(--text-secondary);
    cursor: pointer;
}

.sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 12px;
    flex: 1;
    overflow-y: auto;
}

.nav-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 500;
    transition: all 0.2s ease;
}

.nav-link:hover {
    background-color: var(--bg-surface-elevated);
    color: var(--text-primary);
}

.nav-link.active {
    background: linear-gradient(90deg, rgba(34, 211, 238, 0.12), transparent);
    color: var(--cyan);
    border-left: 3px solid var(--cyan);
    padding-left: 11px;
}

.nav-link-badge-wrapper {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
}

.nav-badge {
    margin-left: auto;
    background-color: var(--status-warning-bg);
    color: var(--status-warning);
    font-size: 0.72rem;
    padding: 2px 7px;
    border-radius: 10px;
    font-family: var(--font-mono);
    font-weight: 600;
}

.sidebar-footer {
    padding: 16px;
    border-top: 1px solid var(--border-subtle);
    background-color: rgba(7, 11, 20, 0.4);
}

.station-meta {
    font-size: 0.75rem;
    color: var(--text-muted);
    display: flex;
    flex-direction: column;
    gap: 3px;
    font-family: var(--font-mono);
}

.meta-line {
    display: flex;
    justify-content: space-between;
}

.meta-label {
    color: var(--text-secondary);
}

.demo-tag-container {
    margin-top: 10px;
    text-align: center;
}

/* ==========================================================================
   MAIN VIEWPORT & TOPBAR
   ========================================================================== */
.main-viewport {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
    background-color: var(--bg-dark);
}

.topbar {
    height: var(--topbar-height);
    background-color: var(--bg-surface);
    border-bottom: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 24px;
    position: sticky;
    top: 0;
    z-index: 90;
    backdrop-filter: blur(8px);
}

.topbar-left {
    display: flex;
    align-items: center;
    gap: 14px;
}

.menu-toggle-btn {
    display: none;
    background: none;
    border: none;
    color: var(--text-primary);
    cursor: pointer;
    padding: 6px;
}

.project-title {
    font-size: 1.22rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.01em;
}

.project-subtitle {
    font-size: 0.75rem;
    color: var(--text-muted);
}

.topbar-right {
    display: flex;
    align-items: center;
    gap: 16px;
}

/* Badges & Pulsing Status */
.mode-pill-badge {
    display: flex;
    align-items: center;
    gap: 7px;
    background: rgba(245, 158, 11, 0.12);
    border: 1px solid rgba(245, 158, 11, 0.4);
    color: #fbbf24;
    padding: 5px 12px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
}

.status-pill-badge {
    display: flex;
    align-items: center;
    gap: 7px;
    background: var(--bg-card);
    border: 1px solid var(--border-bright);
    padding: 5px 12px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--text-secondary);
}

.pulsing-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    position: relative;
}

.pulsing-dot.success {
    background-color: var(--status-normal);
    box-shadow: 0 0 8px var(--status-normal);
}

.pulsing-dot.warning {
    background-color: var(--status-warning);
    box-shadow: 0 0 8px var(--status-warning);
    animation: pulse 1.8s infinite;
}

.pulsing-dot.critical {
    background-color: var(--status-critical);
    box-shadow: 0 0 10px var(--status-critical);
    animation: pulse 1s infinite;
}

@keyframes pulse {
    0% { transform: scale(0.95); opacity: 0.7; }
    50% { transform: scale(1.3); opacity: 1; }
    100% { transform: scale(0.95); opacity: 0.7; }
}

/* Clocks */
.clock-display {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid var(--border-subtle);
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.clock-row {
    display: flex;
    gap: 6px;
}

.clock-label {
    color: var(--text-muted);
}

.clock-value {
    color: var(--cyan);
    font-weight: 500;
}

/* ==========================================================================
   TOOLBAR & CONTROLS
   ========================================================================== */
.control-toolbar {
    background-color: var(--bg-surface-elevated);
    border-bottom: 1px solid var(--border-subtle);
    padding: 10px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
}

.toolbar-left, .toolbar-right {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
}

.toolbar-label {
    font-size: 0.8rem;
    color: var(--text-secondary);
    font-weight: 500;
}

.last-packet-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
}

/* Buttons */
.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 500;
    padding: 7px 14px;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    cursor: pointer;
    transition: all 0.2s ease;
    text-decoration: none;
}

.btn-sm {
    padding: 5px 11px;
    font-size: 0.76rem;
}

.btn-primary {
    background: linear-gradient(135deg, #0284c7, #0891b2);
    color: #ffffff;
    border: 1px solid rgba(34, 211, 238, 0.4);
}

.btn-primary:hover {
    background: linear-gradient(135deg, #0369a1, #06b6d4);
    box-shadow: 0 0 12px var(--cyan-glow);
}

.btn-secondary {
    background-color: rgba(30, 41, 59, 0.8);
    color: var(--text-primary);
    border: 1px solid var(--border-bright);
}

.btn-secondary:hover {
    background-color: #334155;
    border-color: var(--cyan);
}

.btn-outline {
    background: transparent;
    color: var(--text-secondary);
    border: 1px solid var(--border-bright);
}

.btn-outline:hover {
    color: var(--text-primary);
    border-color: var(--cyan);
}

.btn-danger-outline {
    background: transparent;
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.4);
}

.btn-danger-outline:hover {
    background: rgba(239, 68, 68, 0.15);
    color: #ef4444;
}

/* Sudden Spike Notification Banner */
.spike-alert-banner {
    background: linear-gradient(90deg, rgba(239, 68, 68, 0.2), rgba(245, 158, 11, 0.15));
    border-bottom: 1px solid rgba(239, 68, 68, 0.5);
    padding: 10px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    animation: slideDown 0.3s ease;
}

.spike-alert-banner.hidden {
    display: none;
}

.banner-content {
    display: flex;
    align-items: center;
    gap: 12px;
}

.banner-icon {
    font-size: 1.3rem;
}

.banner-text strong {
    color: #f87171;
    margin-right: 8px;
    font-size: 0.88rem;
    letter-spacing: 0.03em;
}

.banner-text span {
    color: #f1f5f9;
    font-size: 0.82rem;
}

.btn-banner-close {
    background: none;
    border: none;
    color: var(--text-muted);
    font-size: 1.1rem;
    cursor: pointer;
}

.btn-banner-close:hover {
    color: #ffffff;
}

@keyframes slideDown {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
}

/* ==========================================================================
   DASHBOARD BODY & CARDS
   ========================================================================== */
.dashboard-body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    flex: 1;
}

/* Card base */
.card {
    background-color: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    overflow: hidden;
}

.card-header {
    padding: 16px 20px;
    border-bottom: 1px solid rgba(30, 41, 59, 0.6);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
}

.card-title {
    font-size: 1.02rem;
    font-weight: 600;
    color: var(--text-primary);
}

.card-subtitle {
    font-size: 0.76rem;
    color: var(--text-muted);
    margin-top: 2px;
}

/* Metrics 5-Card Grid */
.metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 18px;
}

.metric-card {
    background-color: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 16px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: var(--shadow-card);
    transition: transform 0.2s ease, border-color 0.2s ease;
    position: relative;
    overflow: hidden;
}

.metric-card:hover {
    transform: translateY(-2px);
    border-color: var(--border-bright);
}

.metric-card.critical-glow {
    border-color: rgba(239, 68, 68, 0.8);
    box-shadow: 0 0 16px rgba(239, 68, 68, 0.3);
}

.metric-card.warning-glow {
    border-color: rgba(245, 158, 11, 0.8);
    box-shadow: 0 0 16px rgba(245, 158, 11, 0.2);
}

.metric-card .card-header {
    padding: 0 0 12px 0;
    border-bottom: none;
}

.sensor-title-group {
    display: flex;
    align-items: center;
    gap: 10px;
}

.sensor-icon {
    font-size: 1.4rem;
}

.sensor-name {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-highlight);
}

.sensor-tag {
    font-size: 0.7rem;
    color: var(--text-muted);
    display: block;
}

/* Status Badges */
.status-badge {
    font-size: 0.68rem;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 12px;
    font-family: var(--font-mono);
    letter-spacing: 0.05em;
}

.status-badge.normal {
    background-color: var(--status-normal-bg);
    color: var(--status-normal);
    border: 1px solid rgba(16, 185, 129, 0.4);
}

.status-badge.warning {
    background-color: var(--status-warning-bg);
    color: var(--status-warning);
    border: 1px solid rgba(245, 158, 11, 0.4);
}

.status-badge.critical {
    background-color: var(--status-critical-bg);
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.5);
}

.reading-value-row {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin: 4px 0;
}

.metric-value {
    font-size: 1.95rem;
    font-weight: 700;
    font-family: var(--font-mono);
    color: #ffffff;
    letter-spacing: -0.02em;
}

.metric-unit {
    font-size: 0.85rem;
    color: var(--cyan);
    font-weight: 500;
    font-family: var(--font-mono);
}

.reading-subtext {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.74rem;
    color: var(--text-secondary);
}

.trend-indicator {
    font-family: var(--font-mono);
}

.trend-indicator.up { color: #f87171; }
.trend-indicator.down { color: #38bdf8; }
.trend-indicator.neutral { color: var(--text-muted); }

.demo-data-label {
    background: rgba(30, 41, 59, 0.8);
    border: 1px solid var(--border-bright);
    color: var(--text-muted);
    font-size: 0.62rem;
    font-weight: 600;
    font-family: var(--font-mono);
    padding: 1px 5px;
    border-radius: 4px;
}

.demo-data-label.live-hardware, .badge-demo-inline.live-hardware {
    background: rgba(34, 211, 238, 0.15);
    border-color: rgba(34, 211, 238, 0.5);
    color: var(--cyan);
}

.mode-pill-badge.live-connected {
    background: rgba(16, 185, 129, 0.15);
    border-color: rgba(16, 185, 129, 0.5);
    color: #34d399;
}

.mode-pill-badge.hardware-offline {
    background: rgba(239, 68, 68, 0.15);
    border-color: rgba(239, 68, 68, 0.5);
    color: #f87171;
}

.pulsing-dot.neutral {
    background-color: var(--text-muted);
    box-shadow: 0 0 6px var(--text-muted);
}

.badge-demo-inline {
    background: rgba(245, 158, 11, 0.1);
    border: 1px solid rgba(245, 158, 11, 0.3);
    color: #fbbf24;
    font-size: 0.68rem;
    font-family: var(--font-mono);
    padding: 2px 7px;
    border-radius: 4px;
}

/* Hide visible DEMO DATA labels from all graphs and tables */
.chart-card-large .badge-demo-inline:not(.live-hardware),
.multi-chart-grid .badge-demo-inline:not(.live-hardware),
#radiation-trends .badge-demo-inline:not(.live-hardware),
.card-header .badge-demo-inline:not(.live-hardware),
.chart-footer-note .badge-demo-inline:not(.live-hardware) {
    display: none !important;
}

.badge-illustrative {
    background: rgba(168, 85, 247, 0.15);
    border: 1px solid rgba(168, 85, 247, 0.4);
    color: #c084fc;
    font-size: 0.68rem;
    font-family: var(--font-mono);
    padding: 2px 8px;
    border-radius: 4px;
}

.card-footer {
    margin-top: 12px;
}

.threshold-bar-container {
    height: 4px;
    background-color: var(--border-subtle);
    border-radius: 2px;
    overflow: hidden;
}

.threshold-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, #10b981, #22d3ee);
    border-radius: 2px;
    transition: width 0.4s ease, background 0.4s ease;
}

.threshold-labels {
    display: flex;
    justify-content: space-between;
    font-size: 0.66rem;
    color: var(--text-muted);
    margin-top: 5px;
    font-family: var(--font-mono);
}

/* ==========================================================================
   DIAGNOSTIC ROW: HEALTH SCORE & GEOMAGNETIC WIDGET
   ========================================================================== */
.diagnostic-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}

/* Health Card */
.health-card-body {
    padding: 20px;
    display: flex;
    align-items: center;
    gap: 24px;
}

.radial-score-wrapper {
    flex-shrink: 0;
}

.radial-ring {
    width: 140px;
    height: 140px;
    border-radius: 50%;
    background: conic-gradient(var(--status-normal) 0% 100%, var(--border-subtle) 100% 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    box-shadow: 0 0 20px rgba(16, 185, 129, 0.2);
    transition: background 0.5s ease;
}

.radial-ring::before {
    content: '';
    position: absolute;
    width: 112px;
    height: 112px;
    border-radius: 50%;
    background-color: var(--bg-card);
}

.score-number {
    position: relative;
    font-size: 2.4rem;
    font-weight: 800;
    font-family: var(--font-mono);
    color: #ffffff;
    line-height: 1;
}

.score-percent {
    position: relative;
    font-size: 0.9rem;
    color: var(--cyan);
    font-family: var(--font-mono);
    margin-top: -2px;
}

.score-caption {
    position: relative;
    font-size: 0.6rem;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    font-family: var(--font-mono);
}

.health-details {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.health-status-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--status-normal);
    letter-spacing: 0.04em;
    font-family: var(--font-mono);
}

.health-status-desc {
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin-top: 2px;
}

.health-reasons-box {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 10px 14px;
    border-radius: var(--radius-sm);
}

.reasons-heading {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 4px;
    display: block;
}

.reasons-list {
    list-style: none;
    font-size: 0.76rem;
    color: var(--text-highlight);
    display: flex;
    flex-direction: column;
    gap: 3px;
}

.reasons-list li::before {
    content: "• ";
    color: var(--cyan);
}

.disclaimer-callout {
    font-size: 0.68rem;
    color: var(--text-muted);
    line-height: 1.4;
    border-left: 2px solid var(--border-bright);
    padding-left: 8px;
}

/* Geomagnetic Card */
.geomagnetic-body {
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.svg-diagram-wrapper {
    background: radial-gradient(circle at 60% 50%, rgba(14, 22, 38, 0.9), rgba(7, 11, 20, 1));
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 8px;
    display: flex;
    justify-content: center;
}

.magnetosphere-svg {
    width: 100%;
    max-height: 140px;
}

.kp-index-container {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.kp-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.kp-label {
    font-size: 0.78rem;
    color: var(--text-secondary);
    font-weight: 500;
}

.kp-val-badge {
    font-size: 0.74rem;
    font-family: var(--font-mono);
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 4px;
}

.kp-val-badge.quiet {
    background: var(--status-normal-bg);
    color: var(--status-normal);
}

.kp-val-badge.active {
    background: var(--status-warning-bg);
    color: var(--status-warning);
}

.kp-val-badge.storm {
    background: var(--status-critical-bg);
    color: #f87171;
}

.kp-meter-bar {
    height: 18px;
    display: flex;
    border-radius: 4px;
    overflow: hidden;
    position: relative;
    border: 1px solid var(--border-subtle);
}

.kp-segment {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.65rem;
    font-weight: bold;
    color: rgba(255, 255, 255, 0.8);
    font-family: var(--font-mono);
}

.s-green { background-color: #059669; }
.s-yellow { background-color: #d97706; }
.s-orange { background-color: #ea580c; }
.s-red { background-color: #dc2626; }

.kp-needle {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 3px;
    background-color: #ffffff;
    box-shadow: 0 0 6px #ffffff;
    transition: left 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

.kp-caption {
    font-size: 0.7rem;
    color: var(--text-muted);
}

/* ==========================================================================
   CHARTS SECTION
   ========================================================================== */
.chart-card-large {
    padding: 0;
}

.chart-header-row {
    flex-wrap: wrap;
    gap: 12px;
}

.chart-controls {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
}

.chart-legend-pill {
    font-size: 0.68rem;
    font-family: var(--font-mono);
    padding: 2px 8px;
    border-radius: 4px;
    border: 1px solid transparent;
}

.pill-normal { background: var(--status-normal-bg); color: var(--status-normal); border-color: rgba(16, 185, 129, 0.3); }
.pill-warning { background: var(--status-warning-bg); color: var(--status-warning); border-color: rgba(245, 158, 11, 0.3); }
.pill-critical { background: var(--status-critical-bg); color: #f87171; border-color: rgba(239, 68, 68, 0.4); }

.btn-group-segmented {
    display: flex;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 2px;
}

.btn-seg {
    background: transparent;
    border: none;
    color: var(--text-secondary);
    font-size: 0.74rem;
    font-family: var(--font-mono);
    padding: 4px 10px;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.2s ease;
}

.btn-seg:hover {
    color: #ffffff;
}

.btn-seg.active {
    background-color: #0284c7;
    color: #ffffff;
    font-weight: 600;
}

.chart-wrapper-large {
    position: relative;
    height: 320px;
    padding: 16px 20px;
}

.chart-wrapper-medium {
    position: relative;
    height: 220px;
    padding: 16px 20px;
}

.chart-footer-note {
    padding: 10px 20px;
    border-top: 1px solid rgba(30, 41, 59, 0.5);
    background-color: rgba(7, 11, 20, 0.3);
    font-size: 0.72rem;
    color: var(--text-muted);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.multi-chart-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}

/* ==========================================================================
   TABLES: ALERTS & HISTORICAL STREAM
   ========================================================================== */
.table-container {
    width: 100%;
    overflow-x: auto;
    max-height: 380px;
}

.telemetry-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8rem;
    text-align: left;
}

.telemetry-table th {
    background-color: var(--bg-surface-elevated);
    color: var(--text-secondary);
    font-weight: 600;
    padding: 10px 14px;
    border-bottom: 1px solid var(--border-subtle);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    position: sticky;
    top: 0;
    z-index: 10;
}

.telemetry-table td {
    padding: 9px 14px;
    border-bottom: 1px solid rgba(30, 41, 59, 0.5);
    color: var(--text-highlight);
    font-family: var(--font-mono);
    font-size: 0.78rem;
}

.telemetry-table tbody tr:hover {
    background-color: rgba(30, 41, 59, 0.4);
}

.table-empty {
    text-align: center;
    color: var(--text-muted);
    padding: 24px !important;
    font-style: italic;
}

.badge-source {
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 0.68rem;
    font-family: var(--font-mono);
}

.badge-source.demo {
    display: none !important;
    background: rgba(245, 158, 11, 0.15);
    color: #fbbf24;
    border: 1px solid rgba(245, 158, 11, 0.3);
}

.badge-source.esp32 {
    background: rgba(34, 211, 238, 0.15);
    color: var(--cyan);
    border: 1px solid rgba(34, 211, 238, 0.4);
}

/* Footer */
.app-footer {
    padding: 16px 24px;
    border-top: 1px solid var(--border-subtle);
    background-color: var(--bg-surface);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.75rem;
    color: var(--text-muted);
    flex-wrap: wrap;
    gap: 10px;
}

.footer-warning {
    color: #fbbf24;
    font-family: var(--font-mono);
    font-weight: 600;
}

/* ==========================================================================
   MODALS & CODE BLOCKS
   ========================================================================== */
.modal-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(3, 7, 18, 0.8);
    backdrop-filter: blur(4px);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    padding: 16px;
}

.modal-backdrop.show {
    display: flex;
}

.modal-dialog {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-bright);
    border-radius: var(--radius-lg);
    width: 100%;
    max-width: 700px;
    max-height: 85vh;
    display: flex;
    flex-direction: column;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.7);
    overflow: hidden;
}

.modal-header {
    padding: 16px 20px;
    border-bottom: 1px solid var(--border-subtle);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.modal-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: #ffffff;
}

.modal-subtitle {
    font-size: 0.76rem;
    color: var(--text-muted);
}

.modal-close-btn {
    background: none;
    border: none;
    color: var(--text-secondary);
    font-size: 1.3rem;
    cursor: pointer;
    line-height: 1;
}

.modal-close-btn:hover {
    color: #ffffff;
}

.modal-body {
    padding: 20px;
    overflow-y: auto;
    font-size: 0.85rem;
    color: var(--text-highlight);
    display: flex;
    flex-direction: column;
    gap: 14px;
}

.modal-footer {
    padding: 12px 20px;
    border-top: 1px solid var(--border-subtle);
    display: flex;
    justify-content: flex-end;
}

.code-block {
    background-color: #050811;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 12px;
    color: #38bdf8;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    overflow-x: auto;
    white-space: pre;
    line-height: 1.45;
}

.alert-info-box {
    background: rgba(34, 211, 238, 0.1);
    border-left: 3px solid var(--cyan);
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    color: #e0f2fe;
}

.alert-warning-box {
    background: rgba(245, 158, 11, 0.1);
    border-left: 3px solid var(--status-warning);
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    color: #fef3c7;
}

/* ==========================================================================
   RESPONSIVE DESIGN (MOBILE & TABLET BREAKPOINTS)
   ========================================================================== */
@media (max-width: 1080px) {
    .diagnostic-row, .multi-chart-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 860px) {
    .menu-toggle-btn {
        display: block;
    }

    .drawer-close-btn {
        display: block;
    }

    .sidebar {
        position: fixed;
        left: 0;
        top: 0;
        bottom: 0;
        transform: translateX(-100%);
    }

    .sidebar.open {
        transform: translateX(0);
    }

    .drawer-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-color: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(2px);
        z-index: 95;
        display: none;
    }

    .drawer-overlay.active {
        display: block;
    }

    .topbar {
        padding: 0 16px;
    }

    .dashboard-body {
        padding: 16px;
        gap: 16px;
    }

    .health-card-body {
        flex-direction: column;
        text-align: center;
    }

    .health-status-header {
        align-items: center;
    }

    .clock-display {
        display: none;
    }
}

@media (max-width: 580px) {
    .project-title {
        font-size: 1.0rem;
    }

    .project-subtitle {
        display: none;
    }

    .metrics-grid {
        grid-template-columns: 1fr;
    }

    .control-toolbar {
        padding: 10px 16px;
    }

    .chart-wrapper-large {
        height: 250px;
    }

    .app-footer {
        flex-direction: column;
        align-items: flex-start;
    }
}