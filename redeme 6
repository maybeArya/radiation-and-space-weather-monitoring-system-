# APPLICATION ENTRYPOINT
# -----------------------------------------------------------------------------
def initialize_application():
    """Initializes SQLite database and pre-populates initial baseline if empty."""
    db.init_db()
    latest = db.get_latest_reading()
    if not latest:
        # Pre-populate 5 baseline readings so charts display beautifully on initial launch
        print("[INIT] Database empty. Pre-populating baseline demo telemetry...")
        base_time = time.time() - 30
        for i in range(12):
            t_iso = datetime.fromtimestamp(base_time + (i * 2.5), tz=timezone.utc).isoformat()
            sample = {
                "timestamp": t_iso,
                "radiation": round(0.14 + (random.uniform(-0.02, 0.03)), 3),
                "temperature": round(23.8 + (random.uniform(-0.3, 0.4)), 2),
                "voltage": round(3.31 + (random.uniform(-0.01, 0.01)), 3),
                "current": round(0.18 + (random.uniform(-0.01, 0.02)), 3),
                "magnetic": round(47.2 + (random.uniform(-0.6, 0.6)), 2),
                "source": "demo"
            }
            process_and_save_reading(sample)

    # Pre-populate rolling buffer from existing database readings so event IDs and averages persist across restarts
    recent_readings = db.get_readings_history(limit=RadiationAnalysisEngine.LONG_WINDOW)
    for r in recent_readings:
        radiation_engine.add_reading(r['timestamp'], r['radiation'], event_id=r['id'])

    # Demo generator does NOT auto-start on boot.
    # It starts ONLY when the user explicitly clicks "Start Demo" in the dashboard.
    # This ensures demo data never contaminates display before the user intends to see it.
    print("[INIT] Flask server ready. Demo telemetry is OFF by default.")
    print("[INIT] Click 'Start Demo' on the dashboard to begin simulated readings.")


