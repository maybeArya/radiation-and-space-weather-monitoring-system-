# -----------------------------------------------------------------------------
# RADIATION WINDOW ANALYSIS ENGINE
# Maintains in-memory rolling buffers for short and long window averages.
# Reference mean = rolling long-window baseline (or startup nominal).
# Score = ((short_mean - ref_mean) / ref_mean) * 100  (% deviation from baseline)
# Status: Normal if Score < 50%, Warning if 50% <= Score < 200%, Critical if >= 200%
# Windows: Short = previous 3 readings, Long = previous 30 readings
# Event ID: Unique and stable ID assigned at creation, preserved across polling/refreshes.
# -----------------------------------------------------------------------------
class RadiationAnalysisEngine:
    """
    Tracks rolling radiation ADC readings for window averaging and anomaly scoring.
    All calculations use actual recorded values with their real timestamps.
    """
    SHORT_WINDOW = 3    # previous 3 readings
    LONG_WINDOW  = 30   # previous 30 readings
    NOMINAL_REFERENCE = 0.16  # µSv/h — project baseline nominal for Earth surface background

    # Score-based status thresholds (% deviation from reference mean)
    STATUS_WARNING_SCORE  = 50.0    # >= 50% deviation → WARNING
    STATUS_CRITICAL_SCORE = 200.0   # >= 200% deviation → CRITICAL

    def __init__(self):
        self._lock = threading.Lock()
        # list of dicts: {"timestamp": str, "value": float, "event_id": int}
        self._readings: list = []
        self._event_counter = 0

        # Highest recorded values for Table B
        self._max_short_mean: float = 0.0
        self._max_short_mean_ts: str = ""
        self._max_long_mean: float = 0.0
        self._max_long_mean_ts: str = ""

        # Running reference mean (long-window average kept rolling)
        self._reference_mean: float = self.NOMINAL_REFERENCE

    def add_reading(self, timestamp: str, value: float, event_id: Optional[int] = None) -> None:
        """
        Append a new radiation reading to the rolling buffer.
        Assigns a unique and stable event_id once at creation time.
        """
        with self._lock:
            if event_id is None:
                self._event_counter += 1
                assigned_id = self._event_counter
            else:
                assigned_id = int(event_id)
                self._event_counter = max(self._event_counter, assigned_id)

            self._readings.append({
                "timestamp": timestamp,
                "value": value,
                "event_id": assigned_id
            })

            # Keep buffer bounded to at most LONG_WINDOW readings
            if len(self._readings) > self.LONG_WINDOW:
                self._readings = self._readings[-self.LONG_WINDOW:]

            # Update rolling reference and peak values on genuine new reading
            count = len(self._readings)
            short_vals = [r["value"] for r in self._readings[-self.SHORT_WINDOW:]]
            long_vals = [r["value"] for r in self._readings[-self.LONG_WINDOW:]]
            short_mean = sum(short_vals) / len(short_vals) if short_vals else None
            long_mean = sum(long_vals) / len(long_vals) if long_vals else None

            if count >= self.SHORT_WINDOW and long_mean is not None:
                self._reference_mean = long_mean

            if short_mean is not None and short_mean > self._max_short_mean:
                self._max_short_mean = short_mean
                self._max_short_mean_ts = timestamp

            if long_mean is not None and long_mean > self._max_long_mean:
                self._max_long_mean = long_mean
                self._max_long_mean_ts = timestamp

    def _compute_window_mean(self, n: int) -> Optional[float]:
        """Compute the mean of the last n readings. Returns None if buffer has < 1 reading."""
        if not self._readings:
            return None
        window = self._readings[-n:]
        values = [r["value"] for r in window]
        return sum(values) / len(values) if values else None

    def get_analysis(self) -> Dict[str, Any]:
        """
        Returns current radiation analysis snapshot (READ-ONLY query).
        Does NOT increment event counter or alter existing IDs.
        """
        with self._lock:
            if not self._readings:
                return {
                    "raw_adc": None,
                    "short_mean": None,
                    "long_mean": None,
                    "reference_mean": self._reference_mean,
                    "score": None,
                    "status": "NO DATA",
                    "event_id": 0,
                    "timestamp": None,
                    "max_short_mean": None,
                    "max_short_mean_ts": None,
                    "max_long_mean": None,
                    "max_long_mean_ts": None,
                    "window_sizes": {
                        "short": self.SHORT_WINDOW,
                        "long": self.LONG_WINDOW,
                        "actual_count": 0
                    }
                }

            last_entry = self._readings[-1]
            last_ts = last_entry["timestamp"]
            last_val = last_entry["value"]
            last_event_id = last_entry["event_id"]
            count = len(self._readings)

            # Short-window average (previous 3 readings)
            short_vals = [r["value"] for r in self._readings[-self.SHORT_WINDOW:]]
            short_mean = sum(short_vals) / len(short_vals)

            # Long-window average (previous 30 readings)
            long_vals = [r["value"] for r in self._readings[-self.LONG_WINDOW:]]
            long_mean = sum(long_vals) / len(long_vals)

            # Reference mean: use long_mean if we have >= SHORT_WINDOW readings,
            # else use the nominal baseline. This avoids transient startup artifacts.
            if count >= self.SHORT_WINDOW and long_mean is not None:
                self._reference_mean = long_mean
            else:
                self._reference_mean = self.NOMINAL_REFERENCE

            ref = self._reference_mean if self._reference_mean > 0.0 else self.NOMINAL_REFERENCE

            # Score: % deviation of short_mean from reference_mean
            score = round(((short_mean - ref) / ref) * 100.0, 2)

            # Status based on score
            if abs(score) >= self.STATUS_CRITICAL_SCORE:
                status = "CRITICAL"
            elif abs(score) >= self.STATUS_WARNING_SCORE:
                status = "WARNING"
            else:
                status = "NORMAL"

            return {
                "raw_adc": round(last_val, 4),
                "short_mean": round(short_mean, 4),
                "long_mean": round(long_mean, 4),
                "reference_mean": round(ref, 4),
                "score": score,
                "status": status,
                "event_id": last_event_id,
                "timestamp": last_ts,
                "max_short_mean": round(self._max_short_mean, 4),
                "max_short_mean_ts": self._max_short_mean_ts if self._max_short_mean > 0 else None,
                "max_long_mean": round(self._max_long_mean, 4),
                "max_long_mean_ts": self._max_long_mean_ts if self._max_long_mean > 0 else None,
                "window_sizes": {
                    "short": self.SHORT_WINDOW,
                    "long": self.LONG_WINDOW,
                    "actual_count": count
                }
            }

    def get_history(self) -> List[Dict[str, Any]]:
        """
        Returns the rolling buffer as a list of dicts with timestamp, raw_adc,
        short_mean (rolling up to that point), long_mean, and event_id for graphing.
        """
        with self._lock:
            result = []
            readings_copy = list(self._readings)

        for i, item in enumerate(readings_copy):
            s_window = readings_copy[max(0, i - self.SHORT_WINDOW + 1): i + 1]
            l_window = readings_copy[max(0, i - self.LONG_WINDOW + 1): i + 1]
            s_vals = [r["value"] for r in s_window]
            l_vals = [r["value"] for r in l_window]
            sm = round(sum(s_vals) / len(s_vals), 4) if s_vals else None
            lm = round(sum(l_vals) / len(l_vals), 4) if l_vals else None
            result.append({
                "timestamp": item["timestamp"],
                "raw_adc": round(item["value"], 4),
                "short_mean": sm,
                "long_mean": lm,
                "event_id": item["event_id"]
            })
        return result


