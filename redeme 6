# BACKGROUND DEMO DATA GENERATOR
# Safely simulates telemetry without duplicate threads
# -----------------------------------------------------------------------------
class DemoTelemetryGenerator:
    def __init__(self):
        self._thread: Optional[threading.Thread] = None
        self._stop_event = threading.Event()
        self._lock = threading.Lock()
        self.interval = 1.0  # seconds between samples (1s for 1Hz radiation ADC sampling)
        self.packets_generated = 0
        self.anomaly_mode: Optional[str] = None  # None, 'solar_flare', 'voltage_sag', 'thermal_spike'

        # Baseline states for smooth wandering simulation
        self.cur_rad = 0.16
        self.cur_temp = 24.2
        self.cur_volt = 3.31
        self.cur_curr = 0.19
        self.cur_mag = 46.5

    def is_running(self) -> bool:
        with self._lock:
            return self._thread is not None and self._thread.is_alive()

    def start(self, interval: float = 1.0) -> bool:
        with self._lock:
            if self._thread is not None and self._thread.is_alive():
                return False  # Already running, prevent duplicate loop
            self.interval = max(0.5, float(interval))
            self._stop_event.clear()
            self._thread = threading.Thread(target=self._run_loop, daemon=True)
            self._thread.start()
            SYSTEM_STATE["hardware_mode"] = "demo"
            return True

    def stop(self) -> bool:
        with self._lock:
            if self._thread is None or not self._thread.is_alive():
                return False
            self._stop_event.set()
        if self._thread:
            self._thread.join(timeout=3.0)
        with self._lock:
            self._thread = None
        return True

    def trigger_anomaly(self, anomaly_type: str):
        """Allows dashboard to inject a demo scenario for testing alerts."""
        self.anomaly_mode = anomaly_type

    def _next_sample(self) -> Dict[str, Any]:
        """Generates realistic aerospace physics demo readings with noise and drift."""
        # Baseline drift
        self.cur_rad += random.uniform(-0.015, 0.015)
        self.cur_temp += random.uniform(-0.15, 0.15)
        self.cur_volt += random.uniform(-0.008, 0.008)
        self.cur_curr += random.uniform(-0.005, 0.005)
        self.cur_mag += random.uniform(-0.4, 0.4)

        # Natural bounds pull
        self.cur_rad += (0.16 - self.cur_rad) * 0.05
        self.cur_temp += (24.0 - self.cur_temp) * 0.04
        self.cur_volt += (3.30 - self.cur_volt) * 0.08
        self.cur_curr += (0.19 - self.cur_curr) * 0.06
        self.cur_mag += (46.0 - self.cur_mag) * 0.05

        rad_val = max(0.05, self.cur_rad)
        temp_val = self.cur_temp
        volt_val = self.cur_volt
        curr_val = max(0.02, self.cur_curr)
        mag_val = max(5.0, self.cur_mag)

        # Anomaly simulation if triggered or occasional natural cosmic event
        if self.anomaly_mode == 'solar_flare':
            rad_val += random.uniform(2.6, 4.2)  # Critical radiation flare
            mag_val += random.uniform(25.0, 45.0)  # Magnetic storm
            self.anomaly_mode = None  # One-shot spike
        elif self.anomaly_mode == 'voltage_sag':
            volt_val -= random.uniform(0.5, 0.8)  # Brownout
            curr_val += random.uniform(0.35, 0.50)  # Current spike
            self.anomaly_mode = None
        elif self.anomaly_mode == 'thermal_spike':
            temp_val += random.uniform(38.0, 45.0)  # Overheat
            self.anomaly_mode = None
        else:
            # 2% chance of a slight minor natural event for dynamic live feel
            if random.random() < 0.02:
                rad_val += random.uniform(0.35, 0.65)  # Minor burst
            elif random.random() < 0.015:
                mag_val += random.uniform(12.0, 20.0)  # Magnetic wave

        self.packets_generated += 1
        return {
            "radiation": round(rad_val, 3),
            "temperature": round(temp_val, 2),
            "voltage": round(volt_val, 3),
            "current": round(curr_val, 3),
            "magnetic": round(mag_val, 2),
            "source": "demo"
        }

    def _run_loop(self):
        """Worker loop that runs in the background."""
        while not self._stop_event.is_set():
            if SYSTEM_STATE.get("hardware_mode") == "esp32":
                break
            try:
                sample = self._next_sample()
                if self._stop_event.is_set() or SYSTEM_STATE.get("hardware_mode") == "esp32":
                    break
                process_and_save_reading(sample)
            except Exception as e:
                app.logger.error(f"Error in demo telemetry loop: {e}")
            self._stop_event.wait(self.interval)


