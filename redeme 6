@app.route("/api/readings", methods=["POST"])
def api_post_reading():
    """
    Accepts JSON sensor telemetry from ESP32 hardware or simulation clients.
    Expected schema:
    {
      "radiation": 12.4,
      "temperature": 28.6,
      "voltage": 3.3,
      "current": 0.18,
      "magnetic": 48.6,
      "source": "esp32" | "demo"
    }
    """
    if not request.is_json:
        return jsonify({"error": "Request body must be valid application/json."}), 400

    payload = request.get_json(silent=True)
    if not isinstance(payload, dict):
        return jsonify({"error": "Malformed JSON payload. Expected a JSON object."}), 400

    required_fields = ["radiation", "temperature", "voltage", "current", "magnetic"]
    missing = [f for f in required_fields if f not in payload]
    if missing:
        return jsonify({
            "error": f"Missing required sensor fields: {', '.join(missing)}",
            "expected_fields": required_fields
        }), 400
    validated = {}
    for field in required_fields:
        val = payload[field]
        # Validate type is numeric and finite
        if not isinstance(val, (int, float)) or isinstance(val, bool):
            return jsonify({
                "error": f"Field '{field}' must be a numeric value (int or float). Got: {type(val).__name__}"
            }), 400
        if math.isnan(val) or math.isinf(val):
            return jsonify({
                "error": f"Field '{field}' must be a finite number. Got non-finite value."
            }), 400

        # Sanity range checks
        cfg = DEFAULT_THRESHOLDS.get(field, {})
        s_min = cfg.get("sensor_min", -1000.0)
        s_max = cfg.get("sensor_max", 10000.0)
        if val < s_min or val > s_max:
            return jsonify({
                "error": f"Value for '{field}' ({val}) is outside physical sensor capability [{s_min}, {s_max}]."
            }), 400
        validated[field] = float(val)

    # Source handling
    source = payload.get("source", "demo")
    if not isinstance(source, str) or source.lower() not in ("demo", "esp32", "manual"):
        source = "demo"
    validated["source"] = source.lower()

    if "timestamp" in payload and isinstance(payload["timestamp"], str):
        validated["timestamp"] = payload["timestamp"]

    # When valid ESP32 hardware packet arrives, prioritize real data and safely halt demo loop
    if validated["source"] == "esp32":
        SYSTEM_STATE["hardware_mode"] = "esp32"
        SYSTEM_STATE["last_esp32_time"] = time.time()
        if demo_generator.is_running():
            demo_generator.stop()

    # Process reading through analysis and storage pipeline
    result = process_and_save_reading(validated)

    return jsonify({
        "status": "success",
        "message": "Telemetry reading accepted and recorded.",
        "data": result
    }), 201


