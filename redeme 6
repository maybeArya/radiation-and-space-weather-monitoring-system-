def get_connection_status() -> Tuple[str, str]:
    """
    Evaluates current device connection state.
    Returns: (mode: str, status_label: str)
    - ('esp32', 'CONNECTED'): Valid ESP32 reading received within timeout
    - ('offline', 'OFFLINE'): ESP32 was connected but timed out (no packets in >15s)
    - ('demo', 'DEMO MODE'): Demo simulation generator is actively running
    - ('idle', 'IDLE'): Server running, awaiting telemetry
    """
    last_esp32 = SYSTEM_STATE.get("last_esp32_time")
    timeout = SYSTEM_STATE.get("esp32_timeout_seconds", 15.0)

    if last_esp32 is not None:
        elapsed = time.time() - last_esp32
        if elapsed <= timeout:
            return "esp32", "CONNECTED"
        else:
            if demo_generator.is_running():
                return "demo", "DEMO MODE"
            return "offline", "OFFLINE"

    if demo_generator.is_running():
        return "demo", "DEMO MODE"

    return "idle", "IDLE"

# -----------------------------------------------------------------------------
# EVALUATION LOGIC: THRESHOLDS, SUDDEN CHANGES & ELECTRONICS HEALTH RISK
# -----------------------------------------------------------------------------
def evaluate_sensor_status(sensor_key: str, value: float) -> Tuple[str, Optional[str]]:
    """
    Evaluates reading against configurable thresholds.
    Returns (status: 'NORMAL'|'WARNING'|'CRITICAL', explanation: Optional[str]).
    """
    cfg = DEFAULT_THRESHOLDS.get(sensor_key)
    if not cfg:
        return "NORMAL", None

    unit = cfg["unit"]

    if sensor_key == "radiation":
        # Fixed boundary: Normal < 0.50, Warning [0.50, 2.50), Critical >= 2.50
        if value >= cfg["critical_min"]:    # >= 2.50 → CRITICAL
            return "CRITICAL", f"Radiation {value:.2f} {unit} exceeds critical threshold (>= {cfg['critical_min']} {unit})"
        elif value >= cfg["warning_min"]:   # >= 0.50 and < 2.50 → WARNING
            return "WARNING", f"Radiation {value:.2f} {unit} elevated above nominal (>= {cfg['warning_min']} {unit})"
        return "NORMAL", None  # < 0.50 → NORMAL

    elif sensor_key == "temperature":
        if value >= cfg["critical_min"]:
            return "CRITICAL", f"Temperature {value:.1f} {unit} overheating (> {cfg['critical_min']} {unit})"
        elif value < 0.0:
            return "CRITICAL", f"Temperature {value:.1f} {unit} sub-zero freezing hazard"
        elif value > cfg["normal_max"] or value < cfg["normal_min"]:
            return "WARNING", f"Temperature {value:.1f} {unit} out of nominal range ({cfg['normal_min']}-{cfg['normal_max']} {unit})"
        return "NORMAL", None

    elif sensor_key == "voltage":
        if value < cfg["warning_min"]:
            return "CRITICAL", f"Voltage {value:.2f} {unit} brownout hazard (< {cfg['warning_min']} {unit})"
        elif value > cfg["warning_max"]:
            return "CRITICAL", f"Voltage {value:.2f} {unit} overvoltage hazard (> {cfg['warning_max']} {unit})"
        elif value < cfg["normal_min"] or value > cfg["normal_max"]:
            return "WARNING", f"Voltage {value:.2f} {unit} outside nominal band ({cfg['normal_min']}-{cfg['normal_max']} {unit})"
        return "NORMAL", None

    elif sensor_key == "current":
        if value >= cfg["critical_min"]:
            return "CRITICAL", f"Current {value:.3f} {unit} short-circuit / overload hazard (> {cfg['critical_min']} {unit})"
        elif value > cfg["normal_max"]:
            return "WARNING", f"Current {value:.3f} {unit} elevated draw (> {cfg['normal_max']} {unit})"
        return "NORMAL", None

    elif sensor_key == "magnetic":
        if value > cfg["warning_max"]:
            return "CRITICAL", f"Geomagnetic field {value:.1f} {unit} severe disturbance (> {cfg['warning_max']} {unit})"
        elif value < cfg["warning_min"]:
            return "CRITICAL", f"Geomagnetic field {value:.1f} {unit} extreme anomaly (< {cfg['warning_min']} {unit})"
        elif value > cfg["normal_max"] or value < cfg["normal_min"]:
            return "WARNING", f"Geomagnetic field {value:.1f} {unit} geomagnetic variation detected"
        return "NORMAL", None

    return "NORMAL", None


def detect_sudden_change(sensor_key: str, current_val: float, prev_val: Optional[float]) -> Optional[Dict[str, Any]]:
    """
    Detects sudden spikes or large deltas between consecutive samples.
    Returns alert dict if a sudden spike occurred, else None.
    """
    if prev_val is None:
        return None

    cfg = DEFAULT_THRESHOLDS.get(sensor_key)
    if not cfg:
        return None

    delta = abs(current_val - prev_val)
    spike_limit = cfg.get("spike_delta", 9999.0)
    unit = cfg["unit"]

    if delta >= spike_limit:
        severity = "CRITICAL" if delta >= (spike_limit * 1.8) else "WARNING"
        sign = "+" if (current_val >= prev_val) else "-"
        msg = f"Sudden change in {cfg['name']}: {sign}{delta:.2f} {unit} jump detected (from {prev_val:.2f} to {current_val:.2f} {unit})"
        return {
            "sensor": sensor_key,
            "severity": severity,
            "message": msg,
            "value": round(current_val, 3),
            "delta": round(delta, 3)
        }
    return None


def calculate_electronics_health_risk(
    sensor_statuses: Dict[str, str],
    spikes: List[Dict[str, Any]],
    explanations: List[str]
) -> Tuple[int, str, List[str]]:
    """
    Calculates transparent demo subsystem health score (0-100%).
    100 = Optimal nominal operation
    < 80 = Warning (Elevated risk)
    < 50 = Critical (Hazard)
    Clearly marked as demo heuristic.
    """
    score = 100
    reasons = []

    # Penalties for sensor status
    penalties = {
        "radiation": {"WARNING": 20, "CRITICAL": 45},
        "temperature": {"WARNING": 15, "CRITICAL": 35},
        "voltage": {"WARNING": 20, "CRITICAL": 40},
        "current": {"WARNING": 15, "CRITICAL": 30},
        "magnetic": {"WARNING": 10, "CRITICAL": 25}
    }

    for sensor, status in sensor_statuses.items():
        if status in ("WARNING", "CRITICAL"):
            pts = penalties.get(sensor, {}).get(status, 15)
            score -= pts
            reasons.append(f"{sensor.capitalize()} in {status} state (-{pts}% health)")

    # Penalty for sudden spikes
    for spike in spikes:
        spike_pts = 15 if spike["severity"] == "CRITICAL" else 10
        score -= spike_pts
        reasons.append(f"Spike detected in {spike['sensor'].capitalize()} (-{spike_pts}% health)")

    score = max(0, min(100, score))

    if score >= 80:
        overall_status = "NORMAL"
        if not reasons:
            reasons.append("All avionics and sensor rails operating within nominal flight envelope.")
    elif score >= 50:
        overall_status = "WARNING"
    else:
        overall_status = "CRITICAL"

    return score, overall_status, reasons


