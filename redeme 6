# CORE PIPELINE: VALIDATE, PROCESS & RECORD READINGS
# -----------------------------------------------------------------------------
def process_and_save_reading(data: Dict[str, Any]) -> Dict[str, Any]:
    """
    Core function that validates incoming JSON, evaluates thresholds,
    detects sudden changes, computes demo electronics health score,
    deduplicates alerts, and saves to SQLite.
    Shared by both demo loop and the POST /api/readings endpoint.
    """
    timestamp = data.get("timestamp") or datetime.now(timezone.utc).isoformat()
    source = str(data.get("source", "demo")).strip().lower()
    if source != "esp32":
        source = "demo"

    # Numeric conversions
    rad = float(data["radiation"])
    temp = float(data["temperature"])
    volt = float(data["voltage"])
    curr = float(data["current"])
    mag = float(data["magnetic"])

    values = {
        "radiation": rad,
        "temperature": temp,
        "voltage": volt,
        "current": curr,
        "magnetic": mag
    }

    # Evaluate per-sensor thresholds
    sensor_statuses = {}
    explanations = []
    generated_alerts = []

    for key, val in values.items():
        st, exp = evaluate_sensor_status(key, val)
        sensor_statuses[key] = st
        if exp:
            explanations.append(exp)
            # Alert generation with deduplication
            last_state = SYSTEM_STATE["last_alert_states"].get(key)
            if last_state != st:
                # State transition into WARNING or CRITICAL
                alert = db.insert_alert(
                    sensor=key,
                    severity=st,
                    message=exp,
                    value=val,
                    timestamp=timestamp
                )
                generated_alerts.append(alert)
                SYSTEM_STATE["last_alert_states"][key] = st
        else:
            # If normal, reset state
            if SYSTEM_STATE["last_alert_states"].get(key) not in (None, "NORMAL"):
                SYSTEM_STATE["last_alert_states"][key] = "NORMAL"

    # Sudden change detection compared to previous values
    prev_values = SYSTEM_STATE.get("last_sensor_values", {})
    spikes = []
    for key, val in values.items():
        prev_val = prev_values.get(key)
        spike = detect_sudden_change(key, val, prev_val)
        if spike:
            spikes.append(spike)
            # Insert spike alert
            alert = db.insert_alert(
                sensor=key,
                severity=spike["severity"],
                message=spike["message"],
                value=spike["value"],
                timestamp=timestamp
            )
            generated_alerts.append(alert)

    # Compute electronics health / risk score
    risk_score, risk_status, reasons = calculate_electronics_health_risk(
        sensor_statuses, spikes, explanations
    )

    # Insert into database
    record = {
        "timestamp": timestamp,
        "radiation": rad,
        "temperature": temp,
        "voltage": volt,
        "current": curr,
        "magnetic": mag,
        "source": source,
        "risk_score": risk_score,
        "risk_status": risk_status
    }
    saved_reading = db.insert_reading(record)

    # Feed radiation reading into rolling window analysis engine with stable database event_id
    radiation_engine.add_reading(timestamp, rad, event_id=saved_reading.get("id"))

    # Update system live state
    SYSTEM_STATE["last_received_time"] = timestamp
    SYSTEM_STATE["last_received_source"] = source
    SYSTEM_STATE["last_sensor_values"] = values
    SYSTEM_STATE["total_readings_received"] += 1
    if source == "esp32":
        SYSTEM_STATE["last_esp32_time"] = time.time()
        SYSTEM_STATE["hardware_mode"] = "esp32"
        # Prioritize real telemetry: safely halt demo generator when valid ESP32 readings arrive
        if demo_generator.is_running():
            demo_generator.stop()
            app.logger.info("Valid ESP32 reading received. Demo telemetry generator stopped.")

    return {
        "reading": saved_reading,
        "sensor_statuses": sensor_statuses,
        "risk_score": risk_score,
        "risk_status": risk_status,
        "risk_reasons": reasons,
        "spikes_detected": spikes,
        "new_alerts": generated_alerts
    }


